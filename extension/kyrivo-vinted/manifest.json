{
  "manifest_version": 3,
  "name": "Kyrivo — Import Vinted (prototype privé)",
  "version": "0.2.0",
  "description": "Regroupe les fiches Vinted d'une commande et prépare un brouillon unique à vérifier dans Kyrivo.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Kyrivo — Import Vinted",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": [
      "https://kyrivo.fr/import-vinted*",
      "https://www.kyrivo.fr/import-vinted*",
      "https://kyrivo.kartium-tcg.com/import-vinted*"
    ],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}
